{
	"name": "atgreen",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ratchet": "svelte-kit sync && node scripts/quality-ratchet.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@carbon/charts": "^1.11.2",
		"@carbon/charts-svelte": "^1.11.8",
		"@carbon/styles": "^1.33.1",
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-auto": "^2.0.0",
		"@sveltejs/adapter-node": "^1.3.1",
		"@sveltejs/kit": "^1.20.4",
		"@turf/bbox": "^6.5.0",
		"@turf/centroid": "^6.5.0",
		"@types/d3": "^7.4.0",
		"@typescript-eslint/eslint-plugin": "^5.45.0",
		"@typescript-eslint/parser": "^5.45.0",
		"alova": "^2.8.1",
		"autoprefixer": "^10.4.14",
		"carbon-components-svelte": "^0.76.0",
		"carbon-icons-svelte": "^11.4.0",
		"carbon-preprocess-svelte": "^0.9.1",
		"d3": "^7.8.5",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.30.0",
		"mapbox-gl": "^2.15.0",
		"postcss": "^8.4.24",
		"prettier": "^2.8.0",
		"prettier-plugin-svelte": "^2.10.1",
		"svelte": "^4.0.0",
		"svelte-check": "^3.4.3",
		"svelte-reactive-preprocessor": "^0.8.3",
		"tailwindcss": "^3.3.2",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^4.3.6",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"@carbon/telemetry": "^0.1.0",
		"@supabase/postgrest-js": "^1.7.1",
		"@turf/bbox-polygon": "^6.5.0",
		"@turf/buffer": "^6.5.0",
		"@turf/envelope": "^6.5.0",
		"@turf/union": "^6.5.0",
		"simple-statistics": "^7.8.3",
		"svelte-device-info": "^1.0.0"
	}
}
