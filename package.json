{
	"name": "atgreen",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ratchet": "svelte-kit sync && node scripts/quality-ratchet.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.76.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@turf/bbox": "^7.4.0",
		"@turf/centroid": "^7.4.0",
		"@types/d3": "^7.4.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^22.20.5",
		"alova": "^2.8.1",
		"autoprefixer": "^10.7.0",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"d3": "^7.9.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"type": "module",
	"dependencies": {
		"@turf/union": "^7.4.0",
		"maplibre-gl": "^6.11.2",
		"simple-statistics": "^7.8.3"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
