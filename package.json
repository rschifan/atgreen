{
	"name": "atgreen",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ratchet": "svelte-kit sync && node scripts/quality-ratchet.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-node": "^5.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@turf/bbox": "^6.5.0",
		"@turf/centroid": "^6.5.0",
		"@types/d3": "^7.4.0",
		"@types/geojson": "^7946.0.16",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"alova": "^2.8.1",
		"autoprefixer": "^10.6.1",
		"bits-ui": "^2.19.3",
		"carbon-components-svelte": "^0.112.0",
		"carbon-icons-svelte": "^13.15.0",
		"carbon-preprocess-svelte": "^0.11.46",
		"clsx": "^2.1.1",
		"d3": "^7.8.5",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^17.12.0",
		"postcss": "^8.4.24",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.4.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"@turf/union": "^6.5.0",
		"maplibre-gl": "^6.11.2",
		"simple-statistics": "^7.8.3"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
